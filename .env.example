# ─── Server ──────────────────────────────────────────────────────────
PORT=5000
# development | test | production
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────────────────
# Local Docker DB (docker compose up -d): postgresql://teamflow:teamflow@localhost:5433/teamflow
DATABASE_URL=

# ─── JWT ────────────────────────────────────────────────────────────
# Two DIFFERENT random secrets, 32+ chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durations: <number><s|m|h|d>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth (GCP OAuth 2.0 Client ID) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─── URLs ───────────────────────────────────────────────────────────
# FRONTEND_URL is the only origin allowed by CORS.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ─── SSLCommerz (use sandbox credentials during development) ────────
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

# ─── Upstash Redis (REST API) – caching is skipped when unset ───────
# REDIS_URL = Upstash REST URL (https://…), REDIS_TOKEN = Upstash REST token
REDIS_URL=
REDIS_TOKEN=

# ─── Seed: Super Admin demo account (bun run db:seed) ───────────────
# Password: 8+ chars with upper-case, lower-case and a number.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
