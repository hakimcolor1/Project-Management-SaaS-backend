model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  /// bcrypt hash; null for Google-only accounts. Never returned by the API.
  password      String?
  /// Google account subject (`sub` claim) – used for safe account linking.
  googleId      String?  @unique @db.VarChar(255)
  avatar        String?  @db.VarChar(500)
  role          UserRole @default(TEAM_OWNER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedOrganization Organization?        @relation("OrganizationOwner")
  memberships       OrganizationMember[]
  assignedTasks     Task[]               @relation("TaskAssignee")
  createdTasks      Task[]               @relation("TaskCreator")
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}
