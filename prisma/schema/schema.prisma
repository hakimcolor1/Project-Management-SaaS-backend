// TeamFlow – Prisma schema (multi-file)
// Multi-tenant model: every tenant-owned row carries `organizationId`, and
// services always scope queries by the caller's organization.
//
// prisma.config.ts points `schema` at this folder; Prisma merges every file:
//   schema.prisma         generator + datasource (this file)
//   <service>.prisma      models of one service (auth, user, organization,
//                         project, task, subscription, payment, audit-log)
//   enums/<service>.enum.prisma   enums of that service

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7) and the runtime
// client connects through the `pg` driver adapter (src/config/database.ts).
datasource db {
  provider = "postgresql"
}
